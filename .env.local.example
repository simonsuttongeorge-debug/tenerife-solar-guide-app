# Copy this file to .env.local and fill in real values for local development.
# On Railway, set these same three variables under the service's Variables tab
# instead of using this file.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEAD_TO_EMAIL=you@example.com
# Until you verify thetenerifesolarguide.com in Resend, leave this as the
# shared Resend test sender below — it can email your own account address
# without any DNS setup. Once your domain is verified, switch this to
# leads@thetenerifesolarguide.com for better deliverability and branding.
LEAD_FROM_EMAIL=onboarding@resend.dev
